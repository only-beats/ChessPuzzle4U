{
  "rules": {
    "puzzles": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$pid": {
        ".validate": "newData.hasChildren(['fen','solution'])"
      }
    },
    "battles": {
      "$room": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('players').child(auth.uid).exists() || data.child('players').numChildren() < 2)"
      }
    },
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    }
  }
}
